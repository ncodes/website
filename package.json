{
  "name": "fiatx-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "es:lint": "eslint . --ext .js,.jsx,.ts,.tsx,.vue,.json",
    "lint:cache": "eslint --cache --fix",
    "lint:fix": "eslint --quiet --fix . --ext .js,.jsx,.ts,.tsx,.vue,.json",
    "format": "prettier --write \"**/*.+(js|jsx|ts|tsx|vue|json|md)\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@headlessui/react": "^1.6.6",
    "next": "12.2.2",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@types/node": "18.0.4",
    "@types/react": "18.0.15",
    "@types/react-dom": "18.0.6",
    "autoprefixer": "^10.4.7",
    "eslint": "8.19.0",
    "eslint-config-next": "12.2.2",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "postcss": "^8.4.14",
    "tailwindcss": "^3.1.6",
    "typescript": "4.7.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,json}": [
      "npm run lint:fix",
      "npm run format",
      "npm run lint:cache"
    ]
  }
}
